# Streamlit Authentication & Google OAuth Configuration
# Copy this file to .streamlit/secrets.toml and insert your Google OAuth keys.
# Note: .streamlit/secrets.toml is already added to .gitignore for security.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "c7d2e8f190a45bc38271e89dfa12049c5812e9b049281a4b7c891e23f0a1b2c3"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
