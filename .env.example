# Copy this file to ".env" and change what you need. Every line is optional.

# --- Database -----------------------------------------------------------------------------
# PostgreSQL (primary). Leave empty to use a local SQLite file (data/fitcheck.db).
# If PostgreSQL cannot be reached FitCheck automatically falls back to SQLite.
# DATABASE_URL=postgresql+psycopg2://fitcheck:YOUR_PASSWORD@localhost:5432/fitcheck
DATABASE_URL=

# --- Uploads / OCR ----------------------------------------------------------------------------
MAX_UPLOAD_MB=10
# Windows: only needed if Tesseract is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MAX_PAGES=5

# --- Scoring defaults (can also be changed in the Settings page) -------------------------------
SKILL_WEIGHT=0.70        # final = SKILL_WEIGHT * skill match + (1 - SKILL_WEIGHT) * text similarity
PREFERRED_WEIGHT=0.50    # weight of "nice to have" skills compared with required skills (1.0)
USE_SEMANTIC=false       # true needs: pip install sentence-transformers

# --- Optional AI (leave empty: FitCheck works without it) --------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Optional MinIO / S3 compatible object storage ---------------------------------------------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fitcheck
MINIO_SECURE=false
