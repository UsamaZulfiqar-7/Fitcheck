# Copy this file to ".env" and change what you need. Every line is optional.

# --- Database -----------------------------------------------------------------------------
DATABASE_URL=

# --- Uploads / OCR ----------------------------------------------------------------------------
MAX_UPLOAD_MB=10
OCR_MAX_PAGES=5

# --- Scoring defaults (can also be changed in the Settings page) -------------------------------
SKILL_WEIGHT=0.70
PREFERRED_WEIGHT=0.50
USE_SEMANTIC=false

# --- Optional AI (leave empty: FitCheck works without it) --------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Google OAuth 2.0 (Sign in with Google) ----------------------------------------------------
# How to get keys: https://console.cloud.google.com/ -> Credentials -> OAuth 2.0 Client ID
# Leave blank to disable Google sign-in (email/password login still works).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8501/

# --- Optional MinIO / S3 compatible object storage ---------------------------------------------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fitcheck-uploads-private
MINIO_REFERENCE_BUCKET=fitcheck-reference-data
MINIO_SECURE=false
MINIO_ROOT_USER=fitcheck-local-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
